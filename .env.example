# Backend API (Nest)
VITE_API_URL=http://localhost:3000

# Same value as API_KEY on the backend (header x-api-key). Required for protected routes.
VITE_API_KEY=

# Display defaults for summary UI (COP). Backend recalculates and is source of truth.
VITE_BASE_FEE=3500.00
VITE_DELIVERY_FEE=10000.00
VITE_CURRENCY=COP
